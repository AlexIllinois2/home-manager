# 解决 ssh: connect to host github.com port 22: Connection timed out
Host github.com
  HostName ssh.github.com
  Port 443


Host mipad
  HostName 192.168.1.150
  Port 8022
  User u0_a114
  IdentityFile ~/.ssh/id_rsa

# 主入口：Termux sshd（LOS16 新 ROM，nix-on-droid 已不存在）。
# sshd 不会开机自启：Termux 里手动跑 `sshd`，或 adb 后 `su -c /data/local/tmp/sshdwrap`
# 2026-11-17 入口变更登记：设备重启后 IP .4→.41、Termux UID u0_a88→u0_a385、host key 重生成；
#   sshd 以 root+StrictModes=no 拉起（等价复现原 Termux 用户 sshd 语义）。新 host key 已 adb 直读交叉验证。
Host xplay6
  HostName 192.168.1.41
  Port 8022
  User u0_a385
  IdentityFile ~/.ssh/id_rsa

# Redmi Note 8 Pro：nix-on-droid 内的 sshd（端口在 hosts/begonia.nix 的 sshPort）。
# 与 xplay6 不同，这里**不会自动拉起** sshd：需要时在设备上手动执行
#   ~/.config/home-manager/scripts/android/sshd-app.sh
Host begonia
  HostName 192.168.1.5
  Port 2222
  User nix-on-droid
  IdentityFile ~/.ssh/id_rsa

# Redmi Note 8 Pro 的常驻入口：Termux 的 sshd（8022），进去后用 su 10420 操作 proot。
Host begonia-legacy
  HostName 192.168.1.8
  Port 8022
  User u0_a123
  IdentityFile ~/.ssh/id_rsa
