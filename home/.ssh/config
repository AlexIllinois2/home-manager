# 解决 ssh: connect to host github.com port 22: Connection timed out
Host github.com
  HostName ssh.github.com
  Port 443


Host mipad
  HostName 192.168.1.150
  Port 8022
  User u0_a114
  IdentityFile ~/.ssh/id_rsa

# 主入口：Nix-on-Droid proot 内的 sshd（端口在仓库 hosts/xplay6.nix 的 sshPort）
Host xplay6
  HostName 192.168.1.115
  Port 2222
  User nix-on-droid
  IdentityFile ~/.ssh/id_rsa

# 应急入口：仍走 Termux 的 sshd（8022）。nix-on-droid 侧 sshd 起不来时用这个。
Host xplay6-legacy
  HostName 192.168.1.115
  Port 8022
  User u0_a136
  IdentityFile ~/.ssh/id_rsa

# Redmi Note 8 Pro：nix-on-droid 内的 sshd（端口在 hosts/begonia.nix 的 sshPort）。
# 与 xplay6 不同，这里**不会自动拉起** sshd：需要时在设备上手动执行
#   ~/.config/home-manager/scripts/android/sshd-app.sh
Host begonia
  HostName 192.168.1.5
  Port 2222
  User nix-on-droid
  IdentityFile ~/.ssh/id_rsa

# Redmi Note 8 Pro 的常驻入口：Termux 的 sshd（8022），进去后用 su 10420 操作 proot。
Host begonia-legacy
  HostName 192.168.1.5
  Port 8022
  User u0_a123
  IdentityFile ~/.ssh/id_rsa
